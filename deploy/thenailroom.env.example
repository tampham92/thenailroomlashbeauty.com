# /etc/thenailroom.env   (root:www-data, chmod 640)
#
# The build runs as www-data and reads this file, so the group must be able to
# read it.
#
# Every value below is already quoted. KEEP THE QUOTES — this file is sourced
# by the shell during the build, so an unquoted value containing a space, #,
# $, & or a quote is executed as a command instead of assigned.

# --- admin ---------------------------------------------------------------
# openssl rand -base64 32
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Keeps Server Action references decryptable across rebuilds and restarts.
# Generate once with `openssl rand -base64 32` and then leave it alone.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- runtime data (must live OUTSIDE the git checkout) --------------------
# content/*.json is tracked in git but rewritten by /admin; keeping the live
# copy here means `git pull` can never overwrite what the salon edited.
CONTENT_DIR="/var/lib/thenailroom/content"
UPLOAD_DIR="/var/lib/thenailroom/uploads"

# --- this environment ----------------------------------------------------
SITE_URL="https://demo.thenailroomlashbeauty.com"

# 1 on every non-production host. Serves robots.txt "Disallow: /" and adds
# noindex, so the demo cannot be indexed as a duplicate of the real site.
SITE_NOINDEX="1"

PORT="3000"
